# MK-Path environment configuration template.
# Copy to .env and fill in real values. NEVER commit .env.

# MongoDB Atlas (metadata only - never store raw datasets or model files here)
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>/<uri-options>"
MONGODB_DATABASE="mk_path"

# LLM (Phase: agent orchestration) - never hardcode keys, never expose to frontend
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash-latest"

# Server
HOST="127.0.0.1"
PORT="8000"
